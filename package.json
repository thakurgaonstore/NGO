{
  "name": "ngo-erp-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=apps/web",
    "build": "npm run build --workspace=apps/web && node -e \"const fs=require('fs'); fs.cpSync('apps/web/dist', 'dist', {recursive:true});\"",
    "test": "npm run test --workspaces"
  },
  "keywords": [
    "ngo-erp",
    "multi-tenant",
    "firebase",
    "bangladesh",
    "pwa",
    "cloudflare-workers"
  ],
  "author": "Antigravity Team",
  "license": "UNLICENSED"
}
