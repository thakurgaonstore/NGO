# =============================================================================
# NGO ERP — Production Environment Variables
# Copy this file to .env or .env.production before running `npm run build`
# =============================================================================

# 1. Firebase Central Platform Config (Mode A)
# Get these from Firebase Console -> Project Settings -> General -> Web App
VITE_FIREBASE_API_KEY=AIzaSy...Your_Firebase_API_Key
VITE_FIREBASE_AUTH_DOMAIN=your-ngo-platform.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-ngo-platform
VITE_FIREBASE_STORAGE_BUCKET=your-ngo-platform.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=102938475612
VITE_FIREBASE_APP_ID=1:102938475612:web:abcd1234efgh5678

# 2. Cloudflare Edge Worker API URL (For SMS & Auth Provisioning)
# After deploying `apps/workers`, paste the worker URL here:
VITE_WORKER_API_URL=https://ngo-erp-worker.your-subdomain.workers.dev

# 3. Cloudinary Image & Document Storage
# Get these from Cloudinary Dashboard (https://cloudinary.com)
VITE_CLOUDINARY_CLOUD_NAME=your-cloud-name
VITE_CLOUDINARY_UPLOAD_PRESET=ngo_erp_preset
VITE_CLOUDINARY_API_KEY=123456789012345

# 4. Platform Base Domain
VITE_PLATFORM_DOMAIN=ngoerp.xyz
